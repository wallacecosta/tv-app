<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Player fullscreen -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- OSD: info do canal atual (topo-esquerda, auto-oculta) -->
    <LinearLayout
        android:id="@+id/osdView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:background="#DD000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/osdChannelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#e94560"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/osdChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/osdChannelGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Sidebar: lista de canais (esquerda, toggle) -->
    <LinearLayout
        android:id="@+id/sidebarView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EE0d0d1a"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Canais"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="#16213e" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sidebarList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="false"
            android:descendantFocusability="blocksDescendants" />

    </LinearLayout>

    <!-- Barra de dicas (auto-oculta após 5s) -->
    <LinearLayout
        android:id="@+id/hintBar"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:background="#AA000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑↓ Canal  |  OK/← Lista  |  → Ocultar lista  |  VOLTAR Sair"
            android:textColor="#888888"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>
